#!/usr/bin/env bash
# =============================================================================
# dev -- open a project in the terminal IDE layout.
#
#   dev            open the current directory
#   dev ~/code/api open that directory
#
# Creates (or reattaches to) a tmux session named after the directory, laid out
# as Neovim on the left and a shell on the right, with a second window holding
# Claude Code. Reattaching never rebuilds the layout, so running it twice is
# safe.
# =============================================================================
set -euo pipefail

DIR="$(cd "${1:-$PWD}" && pwd)"
# tmux treats . and : as session-name syntax, so flatten them.
SESSION="$(basename "$DIR" | tr '.:' '__')"

if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
  # Window 1: editor on the left, shell on the right.
  tmux new-session -d -s "$SESSION" -c "$DIR" -n editor
  tmux send-keys -t "$SESSION:editor" 'nvim .' C-m
  tmux split-window -h -t "$SESSION:editor" -c "$DIR" -p 35

  # Window 2: Claude Code, full width for reading long output.
  tmux new-window -t "$SESSION" -c "$DIR" -n claude
  tmux send-keys -t "$SESSION:claude" 'claude' C-m

  tmux select-window -t "$SESSION:editor"
  tmux select-pane -t "$SESSION:editor.1"
fi

if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "$SESSION"   # already inside tmux
else
  tmux attach-session -t "$SESSION"
fi
